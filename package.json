{
  "name": "vianei",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "vercel-build": "bash scripts/vercel-build.sh",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "lhci": "npx -y @lhci/cli@0.15 autorun",
    "analyze": "ANALYZE=true next build --webpack",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "npm run payload generate:types",
    "generate:importmap": "npm run payload generate:importmap",
    "migrate": "npm run payload migrate",
    "migrate:create": "npm run payload migrate:create",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file-if-exists=.env scripts/seed.ts",
    "wp:export": "tsx scripts/wp-export.ts",
    "wp:import": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file-if-exists=.env scripts/wp-import.ts",
    "wp:classify": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file-if-exists=.env scripts/wp-classify.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-vercel-blob": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "graphql": "^16.14.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "16.3.6",
    "ogl": "^1.0.11",
    "payload": "3.90.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "^16.3.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
