# Postgres (Neon in production). Local: see README.
DATABASE_URL=postgres://vianei:vianei@localhost:5432/vianei
# Long random string: `openssl rand -hex 32`
PAYLOAD_SECRET=
# Public URL of the site (used by the admin, previews and metadata)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enables draft previews from the admin: `openssl rand -hex 16`
PREVIEW_SECRET=
# Lets scripts (e.g. the WordPress import) expire the site cache: `openssl rand -hex 16`
REVALIDATE_SECRET=
# Vercel Blob token. Leave empty to store uploads on local disk.
BLOB_READ_WRITE_TOKEN=
# Optional: first admin created by `npm run seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Optional: SMTP for contact-form notifications (messages are always saved in /admin → Mensagens).
# Without SMTP_HOST, Payload logs the e-mail to the console instead of sending it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=site@vianei.org.br
